      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{base_url}}/products?per_page=2&page=2"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 200\", function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200 && Array.isArray(pm.response.json().data)) {",
              "var template = `",
              "<style>",
              "  body { font-family: Arial, sans-serif; padding: 16px; }",
              "  h2 { color: #333; }",
              "  table { border-collapse: collapse; width: 100%; }",
              "  th { background-color: #FF6C37; color: white; padding: 10px 14px; text-align: left; }",
              "  td { padding: 8px 14px; border-bottom: 1px solid #ddd; }",
              "  tr:hover { background-color: #f5f5f5; }",
              "  .badge { display: inline-block; padding: 2px 8px; border-radius: 12px; font-size: 12px; font-weight: bold; }",
              "  .in-stock { background-color: #d4edda; color: #155724; }",
              "  .out-of-stock { background-color: #f8d7da; color: #721c24; }",
              "</style>",
              "<h2>Product List</h2>",
              "<table>",
              "  <thead>",
              "    <tr>",
              "      <th>#</th>",
              "      <th>Name</th>",
              "      <th>SKU</th>",
              "      <th>Category</th>",
              "      <th>Price</th>",
              "      <th>Stock</th>",
              "      <th>Status</th>",
              "    </tr>",
              "  </thead>",
              "  <tbody>",
              "    {{#each products}}",
              "    <tr>",
              "      <td>{{id}}</td>",
              "      <td>{{name}}</td>",
              "      <td>{{sku}}</td>",
              "      <td>{{category}}</td>",
              "      <td>$ {{price}}</td>",
              "      <td>{{stock}}</td>",
              "      <td>",
              "        {{#if in_stock}}",
              "          <span class=\"badge in-stock\">In Stock</span>",
              "        {{else}}",
              "          <span class=\"badge out-of-stock\">Out of Stock</span>",
              "        {{/if}}",
              "      </td>",
              "    </tr>",
              "    {{/each}}",
              "  </tbody>",
              "</table>",
              "`;",
              "",
              "var jsonData = pm.response.json();",
              "var products = jsonData.data.map(function(p) {",
              "    return {",
              "        id: p.id,",
              "        name: p.name,",
              "        sku: p.sku,",
              "        category: p.category ? p.category.name : '-',",
              "        price: parseFloat(p.price).toFixed(2),",
              "        stock: p.stock,",
              "        in_stock: p.in_stock",
              "    };",
              "});",
              "",
              "pm.visualizer.set(template, { products: products });",
              "}"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "12 Invalid Stock",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{base_url}}/products/{{product_id}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"stock\": -5\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP 422\", function () { pm.response.to.have.status(422); });",
              "if (pm.response.code === 422) { pm.test(\"Stock validation error returned\", function () { pm.expect(pm.response.json().errors).to.have.property(\"stock\"); }); }"
            ]
          }
        }
      ],
      "response": []
    },
